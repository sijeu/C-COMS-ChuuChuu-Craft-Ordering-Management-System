MONGODB_URI=mongodb://127.0.0.1:27017/chuuchuucraft
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=development
ADMIN_NAME=Shop Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Gmail API OAuth (preferred on Render when SMTP connections time out)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
MAIL_FROM=Chuu Chuu Craft <your-gmail-address@gmail.com>

# Optional alternatives: Resend API or SMTP
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false